API_URL=http://localhost:4000/api/v1
SITE_URL=http://localhost:3000
# Internal showcase is always available in development. Leave disabled in production.
ENABLE_DESIGN_SYSTEM=false

# SITE_URL must exactly match the browser origin for CMS writes (CSRF protection).

# Set only behind an ingress that OVERWRITES this header and blocks direct origin access.
# LEAD_CLIENT_IP_HEADER=cf-connecting-ip
# Must match API's LEAD_PROXY_SECRET (32+ random characters).
# LEAD_PROXY_SECRET=replace-with-a-random-secret
