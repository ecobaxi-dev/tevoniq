# Server-only; never prefix secrets with NEXT_PUBLIC_.
API_URL=http://api:4000/api/v1
SITE_URL=https://tevoniq.com
ENABLE_DESIGN_SYSTEM=false

# Public Pesto proxy is independently gated. Enable only after trusted edge/IP and API setup.
PESTO_PUBLIC_ENROLLMENT_ENABLED=false
# PESTO_CLIENT_IP_HEADER=<header overwritten by trusted ingress>
# LEAD_PROXY_SECRET=<same 32+ character secret as private API>
