# Server-only; never prefix secrets with NEXT_PUBLIC_.
API_URL=http://api:4000/api/v1
SITE_URL=https://tevoniq.com
ENABLE_DESIGN_SYSTEM=false

# Public Pesto proxy is independently gated. Enable only after trusted edge/IP and API setup.
PESTO_PUBLIC_ENROLLMENT_ENABLED=false
# PESTO_CLIENT_IP_HEADER=<header overwritten by trusted ingress>
# LEAD_PROXY_SECRET=<same 32+ character secret as private API>

# Cloudflare Qwen website assistant. Runtime only; never NEXT_PUBLIC_.
SITE_ASSISTANT_ENABLED=false
# CLOUDFLARE_ACCOUNT_ID=<32-character account ID>
# CLOUDFLARE_AI_TOKEN=<Workers AI token with Read and Edit permissions>

# Configure before publishing the advertising landing page (actual secrets stay in hosting settings).
# LEAD_PROXY_SECRET=<matching 32+ character secret on web and API>
# Web only: choose a header overwritten by the ingress, not a caller-controlled header.
# LEAD_CLIENT_IP_HEADER=<verified-ingress-header>
# For x-forwarded-for ONLY: select the validated position from the right of the trusted chain.
# LEAD_TRUSTED_PROXY_HOPS=1
