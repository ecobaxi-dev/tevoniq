NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://tevoniq:REPLACE_WITH_RANDOM_SECRET@postgres:5432/tevoniq?schema=public&sslmode=require
CORS_ORIGIN=https://tevoniq.com
LOG_LEVEL=info
MEDIA_STORAGE=s3
MEDIA_MAX_FILE_BYTES=10485760
MEDIA_MAX_PIXELS=25000000
MEDIA_S3_BUCKET=replace-with-private-media-bucket
MEDIA_S3_REGION=us-east-1
MEDIA_S3_FORCE_PATH_STYLE=true
# MEDIA_S3_ENDPOINT=https://your-s3-compatible-endpoint.example
# Use workload identity / IAM roles or inject AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# REDIS_URL=rediss://redis.example.com:6379

# Required for production CV uploads; scanner must be on a private network.
CV_CLAMAV_HOST=clamav
CV_CLAMAV_PORT=3310

# Enable after configuring a verified sender and real SMTP credentials.
EMAIL_TRANSPORT=disabled
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM=contact@tevoniq.com
# SMTP_HOST=replace-with-smtp-host
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-with-smtp-user
# SMTP_PASSWORD=replace-with-secret

TURNSTILE_MODE=disabled
# TURNSTILE_MODE=turnstile
# TURNSTILE_SITE_KEY=replace-with-site-key
# TURNSTILE_SECRET_KEY=replace-with-secret
# TURNSTILE_HOSTNAMES=tevoniq.com,www.tevoniq.com
