NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tevoniq:tevoniq_local_only@localhost:5432/tevoniq?schema=public
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
MEDIA_STORAGE=local
MEDIA_LOCAL_ROOT=.data/media
MEDIA_MAX_FILE_BYTES=10485760
MEDIA_MAX_PIXELS=25000000
# Optional; no Redis-dependent features are enabled yet.
# REDIS_URL=redis://localhost:6379


# Operator-only admin provisioning: set CMS_ADMIN_EMAIL and CMS_ADMIN_PASSWORD
# in the process environment before npm run cms:admin. No default credentials.

# Lead emails: configure recipients in /admin/lead-settings.
EMAIL_TRANSPORT=disabled
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM=contact@your-domain.example
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-user
# SMTP_PASSWORD=your-secret

# Turnstile: all three values required when enabled.
TURNSTILE_MODE=disabled
# TURNSTILE_MODE=turnstile
# TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-secret-key
# TURNSTILE_HOSTNAMES=your-domain.example,www.your-domain.example

# Same random secret (32+ characters) on web and API for trusted client IP forwarding.
# LEAD_PROXY_SECRET=replace-with-a-random-secret
