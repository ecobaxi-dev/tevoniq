{
  "name": "@tevoniq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch --env-file=.env dist/main.js\"",
    "predev": "npm run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tooling.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "cms:admin": "tsx prisma/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tevoniq/types": "*",
    "@tevoniq/validation": "*",
    "dotenv": "^17.2.3",
    "express-rate-limit": "8.7.0",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "nestjs-pino": "5.1.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "saxes": "^6.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0"
  }
}
