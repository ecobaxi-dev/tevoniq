# Supply real values through your deployment secret manager. Do not commit real secrets.
POSTGRES_USER=tevoniq
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_DB=tevoniq
POSTGRES_PORT=5432


# Pesto registration backend stays disabled until the client/proxy flow is ready.
PESTO_REGISTRATION_ENABLED=false
# Required only when enabling, through the API secret store: 32 random bytes as 64 lowercase hex characters.
# PESTO_REGISTRATION_EMAIL_KEY=replace-with-dedicated-private-key

# Trial signing stays off until host enrollment and public trust pins are ready.
PESTO_TRIAL_ENABLED=false
# PESTO_LICENSE_KEY_ID=licensing-v1
# PESTO_LICENSE_PRIVATE_KEY=<base64 PKCS8 DER; API-only dedicated P-256 key>
