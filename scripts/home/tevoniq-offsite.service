[Unit]
Description=Encrypted TEVONIQ database backup to Google Drive
Wants=network-online.target
After=network-online.target tevoniq-backup.service
Requires=tevoniq-backup.service
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/tevoniq-backup/offsite.env
ExecStart=/bin/bash /home/tevoniq/apps/tevoniq/scripts/home/offsite-backup.sh
ExecStartPost=/bin/bash /home/tevoniq/apps/tevoniq/scripts/home/backup-config.sh
TimeoutStartSec=45min
Restart=on-failure
RestartSec=15min
UMask=0077
Nice=10
